# Repo-root .env: used by scripts (npm run seed). Never commit the real file.
# Values: Supabase dashboard -> Project Settings -> API Keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SECRET key bypasses RLS. Only P1 (or whoever seeds) needs it. Never put it in the app.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Password for all seeded test accounts. Share it in the group chat, not here.
SEED_PASSWORD=
