# Copy to the repository-root .env (the app's npm scripts load ../../.env).
# Leave the Supabase values empty to run on the in-device mock backend.

# Supabase project (URL and publishable key are pinned in the group chat; both are safe in the app)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to "mock" to force the mock backend even when the keys above are set
EXPO_PUBLIC_BACKEND=

# Mockpass bridge (services/mockpass-auth), e.g. http://localhost:3001 or your LAN IP for Expo Go
EXPO_PUBLIC_MOCKPASS_AUTH_URL=

# Google Maps: browser key (Maps Embed API) for web; native key for development builds
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
GOOGLE_MAPS_API_KEY=
