# Copy to summer-ui-ux/.env. Leave the Supabase values empty to run on the mock backend.
# Same values as apps/mobile/.env (Supabase dashboard -> Project Settings -> API Keys,
# or `npx supabase status` for a local stack). Both are safe to ship (RLS protects the data).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Xavier's Mockpass auth bridge for "Log in with Singpass" (see README).
EXPO_PUBLIC_MOCKPASS_AUTH_URL=

# Optional: set to "mock" to force the mock backend even when the keys above are filled in.
EXPO_PUBLIC_BACKEND=

# Google Maps
# Used by the Expo config template at summer-ui-ux/app.config.google-maps.example.ts.
# Restrict this key in Google Cloud Console to this app's Android/iOS application.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Optional: browser key for a Google Maps JavaScript implementation on web.
# Restrict this key by HTTP referrer; do not reuse the native key.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=YOUR_GOOGLE_MAPS_WEB_API_KEY

# OneMap is used by the server-side monthly planning-area sync.
# Set ONEMAP_TOKEN as a Supabase Edge Function secret, not in this client env.
